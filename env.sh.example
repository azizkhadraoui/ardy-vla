# env.sh -- copy to env.sh and edit. Sourced by every *_run.sh.
module load cuda/12.1 2>/dev/null || true
source "$HOME/miniconda3/etc/profile.d/conda.sh" && conda activate ardy      # see README "Install"
export PY=python
export WORK_DIR="$HOME/ardy_vla/runs"          # all outputs (data/ tokenizer/ ckpt/ results/ figures/ episodes/)
export DATA_DIR="$HOME/ardy_vla/libero_hdf5"    # the 4 suites, ~25 GB of HDF5
export LIBERO_DIR="$HOME/ardy_vla/LIBERO"       # clone of Lifelong-Robot-Learning/LIBERO (01/05/08 clone it if absent)
export HF_TOKEN="${HF_TOKEN:-}"                 # optional; avoids the Hugging Face unauthenticated rate limit on download
export MUJOCO_GL=egl
export PYOPENGL_PLATFORM=egl
export TOKENIZERS_PARALLELISM=false
# Weights & Biases (optional). WANDB=0 -> every wandb call in the pack is a no-op and nothing is imported.
# Stages 2-8 log to it; 3/4/5 share one run per checkpoint (id "{variant}_s{seed}"), so a variant's training curve,
# its open-loop adherence and its closed-loop success end up on the same run.
export WANDB="${WANDB:-0}"                     # 1 to enable (pip install wandb; wandb login once on the login node)
export WANDB_PROJECT="${WANDB_PROJECT:-ardy-vla}"
if [ -n "${WANDB_ENTITY:-}" ]; then export WANDB_ENTITY; fi   # your team/user; leave unset for the account default
# export WANDB_MODE=offline                    # compute nodes with no outbound network; then on the login node:
#                                              #   wandb sync $WORK_DIR/wandb/offline-run-*
export PRESET="${PRESET:-long}"                 # long (d=384, 6 layers, 30k) | quick | scale
export SEEDS="${SEEDS:-0,1,2}"
mkdir -p "$WORK_DIR"
